APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Cloud API (Meta)
# NOTE: These are now primarily managed from the admin panel
# (Admin → System → Settings → WhatsApp Settings), stored encrypted in the DB.
# The values here are only a fallback used when the matching DB field is blank.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_TEMPLATE_LANG=en_US
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=
WHATSAPP_TEMPLATE_BOOKING_CANCELLED=
WHATSAPP_TEMPLATE_QUOTATION_SENT=
WHATSAPP_ATTACH_QUOTATION_PDF=false
WHATSAPP_ATTACH_BOOKING_INVOICE=false

# AI Travel Assistant (LLM over inbound WhatsApp — customer self-service + new inquiries)
# Disabled by default. Requires an AI provider key (see OPENAI_API_KEY etc. below).
# Keyword auto-replies always run first; the assistant only handles messages no
# rule matched, and only when the conversation is not handed to a human.
WHATSAPP_AI_ASSISTANT_ENABLED=false
WHATSAPP_AI_PROVIDER=
WHATSAPP_AI_MODEL=
WHATSAPP_AI_MAX_TOOL_ITERATIONS=5
WHATSAPP_AI_HISTORY_LIMIT=12
WHATSAPP_AI_REQUIRE_VERIFICATION=true

# Meta Lead Ads (leadgen webhook)
META_LEADS_ENABLED=false
META_LEADS_API_VERSION=v21.0
META_LEADS_VERIFY_TOKEN=
META_LEADS_APP_SECRET=
META_LEADS_PAGE_ACCESS_TOKEN=

# Google Ads Lead Form Extensions (webhook key)
GOOGLE_LEADS_ENABLED=false
GOOGLE_LEADS_KEY=

# ── Marketing / Advertising platform ──────────────────────────────
# Google Ads API (campaign management)
GOOGLE_ADS_ENABLED=false
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REDIRECT_URI="${APP_URL}/admin/marketing/google/callback"
GOOGLE_ADS_API_VERSION=v17

# Meta Marketing API (campaign management)
META_ADS_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_ADS_API_VERSION=v21.0
META_ADS_REDIRECT_URI="${APP_URL}/admin/marketing/meta/callback"
META_ADS_WEBHOOK_VERIFY_TOKEN=

# AI providers (marketing copilot / creative / analysis)
# NOTE: These keys are now primarily managed from the admin panel
# (Admin → System → AI Providers), stored encrypted in the DB. The values here
# are only a fallback used when the matching DB field is blank.
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_MONTHLY_BUDGET=
AI_ENABLE_IMAGE=false
AI_ENABLE_VIDEO=false
AI_ENABLE_AUTO_OPTIMIZE=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional per-provider model overrides (blank => sane per-provider default).
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=
GROQ_MODEL=
# OpenRouter model names use the "vendor/model" form, e.g. openai/gpt-4o-mini
OPENROUTER_MODEL=

# Super admin (created by seeders)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
